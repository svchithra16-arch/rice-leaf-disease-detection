# AgriVersion Configuration
SECRET_KEY=agriversion_super_secret_production_key_2026_jwt_session
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database
DATABASE_URI=sqlite:///agriversion.db

# Multimodal AI API (Optional - Google Gemini Multimodal API)
# If left blank, AgriVersion automatically uses its built-in deep agricultural vision & reasoning engine
GEMINI_API_KEY=

# Uploads and Storage
UPLOAD_FOLDER=uploads
REPORTS_FOLDER=static_reports
MAX_CONTENT_LENGTH=16777216  # 16MB max upload

# ML Model Thresholds
CONFIDENCE_THRESHOLD=0.60
BLUR_THRESHOLD=60.0
